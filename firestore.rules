rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat in [
        'Moradia',
        'Contas',
        'Alimentação',
        'Transporte',
        'Saúde',
        'Lazer',
        'Educação',
        'Outros'
      ];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.defaultSalary is number &&
        data.defaultSalary >= 0 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMonthSummary(data, userId) {
      return data.userId == userId &&
        data.monthKey is string &&
        data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.salary is number &&
        data.salary >= 0 &&
        data.additionalIncome is number &&
        data.additionalIncome >= 0 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidIncomeItem(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.monthKey is string &&
        data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 120 &&
        data.amount is number &&
        data.amount >= 0 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidExpenseItem(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.monthKey is string &&
        data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 120 &&
        data.amount is number &&
        data.amount >= 0 &&
        data.isPaid is bool &&
        isValidCategory(data.category) &&
        (!('dueDay' in data) || (data.dueDay is number && data.dueDay >= 1 && data.dueDay <= 31)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User profile doc
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Month summaries
      match /months/{monthKey} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidMonthSummary(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // Incomes subcollection
      match /incomes/{incomeId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(incomeId) && isValidIncomeItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(incomeId) && isValidIncomeItem(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(incomeId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(expenseId) && isValidExpenseItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(expenseId) && isValidExpenseItem(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
      }
    }
  }
}
